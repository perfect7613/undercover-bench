# Undercover Bench Environment Configuration
# Copy this file to .env and configure with your keys:
# cp .env.example .env

# Modal credentials (used for GPU server deployment & remote inference)
# Authenticate via: modal setup or set these:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Hugging Face Hub (used for automatic LoRA checkpoint publishing)
# Authenticate via: huggingface-cli login or set this:
# HF_TOKEN=
